        <mxCell id="tx" value="LiteEthPHYXGMIITX&#10;&#10;TX FSM (IDLE / TRANSMIT)&#10;IFG range state (2b)&#10;Deficit idle count (2b)&#10;lane-0 / lane-4 start, half-word stitch" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#284b63;fontSize=12;" vertex="1" parent="1">
